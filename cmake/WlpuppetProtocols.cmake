# Embeds Wayland protocol XML into a target using C23 #embed.
#
# The proxy needs a message signature for every interface a client may bind, so
# we embed all of wayland.xml and wayland-protocols, plus any extra directories
# the user names (e.g. wlr-protocols or plasma-wayland-protocols checkouts).

set(WLPUPPET_EXTRA_PROTOCOL_DIRS "" CACHE STRING
    "Semicolon-separated list of extra directories with protocol XML to embed")

function(wlpuppet_embed_protocols target)
    # Priority decides which definition wins when two files declare the same
    # interface name: lower is preferred (stable before staging before unstable).
    set(groups
        "0|${WAYLAND_PKGDATADIR}/wayland.xml"
        "1|${WAYLAND_PROTOCOLS_PKGDATADIR}/stable"
        "2|${WAYLAND_PROTOCOLS_PKGDATADIR}/staging"
        "3|${WAYLAND_PROTOCOLS_PKGDATADIR}/unstable")
    foreach(dir IN LISTS WLPUPPET_EXTRA_PROTOCOL_DIRS)
        list(APPEND groups "4|${dir}")
    endforeach()

    set(arrays "")
    set(entries "")
    set(index 0)
    foreach(group IN LISTS groups)
        string(REPLACE "|" ";" group "${group}")
        list(GET group 0 priority)
        list(GET group 1 path)
        if(IS_DIRECTORY "${path}")
            file(GLOB_RECURSE files CONFIGURE_DEPENDS "${path}/*.xml")
            list(SORT files)
        else()
            set(files "${path}")
        endif()
        foreach(file IN LISTS files)
            cmake_path(GET file FILENAME name)
            string(APPEND arrays "static const unsigned char protocol_${index}[] = {\n#embed \"${file}\"\n};\n")
            string(APPEND entries "    {\"${name}\", protocol_${index}, sizeof protocol_${index}, ${priority}},\n")
            math(EXPR index "${index} + 1")
        endforeach()
    endforeach()

    set(output "${CMAKE_CURRENT_BINARY_DIR}/embedded_protocols.c")
    file(CONFIGURE OUTPUT "${output}" @ONLY CONTENT [[
// Generated by WlpuppetProtocols.cmake. Do not edit.
#include "wlpuppet/embedded_protocols.h"

@arrays@
const struct wlp_embedded_protocol wlp_embedded_protocols[] = {
@entries@};

const size_t wlp_embedded_protocol_count = sizeof wlp_embedded_protocols / sizeof wlp_embedded_protocols[0];
]])
    target_sources(${target} PRIVATE "${output}")
    message(STATUS "wlpuppet: embedding ${index} protocol files")
endfunction()
